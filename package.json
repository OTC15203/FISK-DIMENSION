{
  "name": "fisk-dimension-omega9",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.9.4",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "yarn workspace fisk-dimension-frontend dev",
    "backend": "yarn workspace fisk-dimension-backend dev",
    "build": "yarn workspaces foreach -pt run build",
    "lint": "yarn workspaces foreach -pt run lint",
    "postinstall": "echo 'Workspaces installed'"
  }
}
