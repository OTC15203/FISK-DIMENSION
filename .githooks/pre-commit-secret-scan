#!/usr/bin/env bash
STAGED_FILES=$(git diff --cached --name-only)
FAIL=0
patterns=("AWS_ACCESS_KEY_ID" "AWS_SECRET_ACCESS_KEY" "PRIVATE_KEY" "BEGIN RSA PRIVATE KEY" "BEGIN PRIVATE KEY" "GOOGLE_API_KEY" "NETLIFY_AUTH_TOKEN" "STRIPE_SECRET")
for f in $STAGED_FILES; do
  if [[ -f "$f" ]]; then
    for p in "${patterns[@]}"; do
      if git grep -n --cached -I -E "$p" -- "$f" >/dev/null 2>&1; then
        echo "Possible secret pattern '$p' found in $f"
        FAIL=1
      fi
    done
  fi
done
if [[ $FAIL -eq 1 ]]; then
  echo "Commit blocked: possible secrets detected. Remove or move to env variables."
  exit 1
fi
exit 0
